{
    "name": "aiseeder/laravel-ai-seeder",
    "description": "Generate realistic, relational, temporally coherent synthetic data for non-production Laravel environments.",
    "keywords": ["laravel", "seeder", "factory", "synthetic-data", "ai", "faker"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "fakerphp/faker": "^1.24",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "AISeeder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AISeeder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AISeeder\\AISeederServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
