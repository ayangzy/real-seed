{
    "name": "ayangzy/real-seed",
    "description": "Generate realistic, relational, temporally coherent synthetic data for non-production Laravel environments.",
    "keywords": [
        "laravel",
        "seeder",
        "seeding",
        "factory",
        "faker",
        "synthetic-data",
        "test-data",
        "fake-data",
        "ai"
    ],
    "license": "MIT",
    "homepage": "https://github.com/ayangzy/real-seed",
    "support": {
        "issues": "https://github.com/ayangzy/real-seed/issues",
        "source": "https://github.com/ayangzy/real-seed"
    },
    "authors": [
        {
            "name": "ayangzy",
            "homepage": "https://github.com/ayangzy"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.3",
        "fakerphp/faker": "^1.24",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Ayangzy\\RealSeed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ayangzy\\RealSeed\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ayangzy\\RealSeed\\RealSeedServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
